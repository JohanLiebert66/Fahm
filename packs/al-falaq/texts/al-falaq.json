{
  "id": "al-falaq",
  "title": {
    "en": "Al-Falaq (113)"
  },
  "ref": "113",
  "segments": [
    {
      "id": "1",
      "ref": "113:1",
      "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ"
    },
    {
      "id": "2",
      "ref": "113:2",
      "text": "مِن شَرِّ مَا خَلَقَ"
    },
    {
      "id": "3",
      "ref": "113:3",
      "text": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ"
    },
    {
      "id": "4",
      "ref": "113:4",
      "text": "وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ"
    },
    {
      "id": "5",
      "ref": "113:5",
      "text": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ"
    }
  ]
}
